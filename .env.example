# --- Webhook SASI (POST/GET /api/hse/webhook) ---------------------------------
# Segredo da URL cadastrada no painel do SASI. Aceito no header x-webhook-secret
# ou na query ?secret= (o painel pode não permitir header customizado). Sem esta
# variável, o webhook recusa TODAS as chamadas.
HSE_WEBHOOK_SECRET=

# Webhook de TESTE (POST/GET /api/hse/webhook-test): só captura o payload para
# descobrir o formato do canal, não grava respostas. Vazio = usa HSE_WEBHOOK_SECRET.
# HSE_TEST_WEBHOOK_SECRET=

# Opcional: só aceita mensagens deste canal SASI (id numérico). Vazio = qualquer.
# HSE_CHANNEL_ID=

# --- Banco ---------------------------------------------------------------------
# Vazio = arquivo local ./data/hse-it.db (é o que o Docker usa, com volume).
# Em produção, o banco Turso/libSQL próprio deste projeto:
# TURSO_DATABASE_URL=libsql://exemplo.turso.io
# TURSO_AUTH_TOKEN=

# --- Mapeamento do formulário (opcionais) --------------------------------------
# O mapper localiza as 35 afirmativas pelo texto/ordem do campo. Estes ajustam só
# os campos de cabeçalho, se o nome no SASI for diferente do esperado.
# HSE_FIELD_SETOR=setor
# HSE_FIELD_IDADE=idade
# HSE_FIELD_DATA=data
# Mínimo de afirmativas reconhecidas para aceitar a mensagem (padrão 10).
# HSE_MIN_ANSWERS=10
# Fuso para a data da resposta quando o formulário não traz o campo "data".
# HSE_TIMEZONE=America/Campo_Grande
